{
  "name": "b2c-storefront",
  "version": "1.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "i18n:check-key-parity": "tsx scripts/check-i18n-key-parity.ts",
    "test": "pnpm test:node && vitest run && pnpm test:eslint-rules",
    "test:node": "sh -c 'pnpm test:node:default; a=$?; pnpm test:node:rsc; b=$?; [ \"$a\" -eq 0 ] && exit \"$b\"; exit \"$a\"'",
    "test:node:default": "tsx --test tests/*.test.mjs",
    "test:node:rsc": "tsx --conditions=react-server --test tests/react-server/*.test.mjs",
    "test:vitest": "vitest run",
    "test:eslint-rules": "node --test \"eslint-plugin-gp/rules/__tests__/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:flag-on": "playwright test multi-vendor-flag-on.spec",
    "test:e2e:snapshot-off": "playwright test multi-vendor-flag-off-snapshot.spec",
    "test:ux-evidence": "playwright test --config playwright.config.ts e2e/ux-evidence"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.1",
    "@hookform/resolvers": "^3.10.0",
    "@internationalized/date": "^3.12.1",
    "@medusajs/js-sdk": "2.14.2",
    "@medusajs/types": "2.14.2",
    "@medusajs/ui": "^4.1.13",
    "@mercurjs/client": "2.1.1",
    "@sentry/nextjs": "^10.40.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.1.0",
    "@talkjs/react": "^0.1.11",
    "@types/he": "^1.2.3",
    "@types/js-cookie": "^3.0.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "embla-carousel-react": "^8.5.2",
    "he": "^1.2.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "isomorphic-dompurify": "^3.12.0",
    "js-cookie": "^3.0.5",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash": "^4.17.21",
    "next": "15.5.12",
    "next-intl": "^3.26.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.5.2",
    "react-leaflet": "^4.2.1",
    "sanitize-html": "^2.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "talkjs": "^0.37.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^3.2.3",
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/dompurify": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/lodash": "^4.17.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "eslint-plugin-gp": "link:./eslint-plugin-gp",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^0.11.2",
    "jsdom": "^29.0.1",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "storybook": "^8.4.7",
    "storybook-next-intl": "^1.2.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@sentry/cli"
    ],
    "packageExtensions": {
      "@medusajs/ui": {
        "dependencies": {
          "@internationalized/date": "^3.12.1"
        }
      }
    },
    "overrides": {
      "@medusajs/admin-sdk": "2.14.2",
      "@medusajs/admin-shared": "2.14.2",
      "@medusajs/admin-vite-plugin": "2.14.2",
      "@medusajs/cli": "2.14.2",
      "@medusajs/dashboard": "2.14.2",
      "@medusajs/framework": "2.14.2",
      "@medusajs/icons": "2.14.2",
      "@medusajs/js-sdk": "2.14.2",
      "@medusajs/medusa": "2.14.2",
      "@medusajs/test-utils": "2.14.2",
      "@medusajs/types": "2.14.2",
      "import-in-the-middle": "3.0.1"
    }
  }
}
