# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright E2E (Story v160-8-8)
/playwright-report/
/test-results/
/e2e/__snapshots__/*.png
/e2e/__snapshots__/*.jpeg
# JSON state snapshots ARE committed (not pixel diffs)


# Lighthouse Chrome user-data-dir artifacts (Windows-style paths leak from headless runs)
C:\\Users\\
**/C:\\Users\\
lighthouse.[0-9]*/
**/lighthouse.[0-9]*/


# Lighthouse Chrome user-data-dir leaks (Windows paths from headless runs)
C:\\Users\\
