; pnpm config — story v160-2-4 path B
;
; The storefront has several runtime imports of transitive dependencies
; that yarn classic hoisted automatically (e.g. @medusajs/icons,
; embla-carousel, sonner — pulled via @medusajs/ui / embla-carousel-react
; / etc). Switching to pnpm 10+ enables strict isolation by default,
; which breaks these imports. shamefully-hoist=true keeps the legacy
; resolution behavior. Story 2.7 (naming preservation audit) will
; classify which transitive imports should be promoted to explicit deps.
shamefully-hoist=true

; The repo runs a multi-package monorepo at the super root, but storefront
; is a Mercur 1.5.4 baseline submodule consumed standalone. Keep workspace
; isolation off so super-root pnpm-workspace.yaml never accidentally
; pulls storefront into a different resolution graph.
ignore-workspace-root-check=true
